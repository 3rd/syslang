{
  "name": "syslang.js",
  "version": "1.0.0",
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.mjs",
  "types": "./dist/lib.d.cts",
  "exports": {
    "require": {
      "types": "./dist/lib.d.cts",
      "default": "./dist/lib.cjs"
    },
    "import": {
      "types": "./dist/lib.d.mts",
      "default": "./dist/lib.mjs"
    }
  },
  "scripts": {
    "build": "npm run clean && pkgroll --target=node20",
    "dev": "tsx watch --test src/lib.test.ts",
    "test": "tsx --test src/lib.test.ts",
    "tsc": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run tsc && npm run test",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.3",
    "pkgroll": "^2.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "tree-sitter": "^0.25.0",
    "tree-sitter-syslang": "link:../tree-sitter-syslang/"
  }
}
